# Copy to .env and adjust
TZ=America/New_York

# LifeOS morning-briefing weather (find yours at https://open-meteo.com)
LIFEOS_LAT=
LIFEOS_LON=

# Grocy pantry sync (create a key in Grocy → Settings → Manage API keys)
GROCY_URL=http://grocy
GROCY_API_KEY=

# Plex (profile: media) — claim token from https://plex.tv/claim (valid 4 min,
# only needed on first start). MEDIA_DIR holds your movies/tv/music folders.
PLEX_CLAIM=
MEDIA_DIR=
