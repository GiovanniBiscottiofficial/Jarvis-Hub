# Copy to .env and adjust
TZ=America/New_York

# LifeOS morning-briefing weather (find yours at https://open-meteo.com)
LIFEOS_LAT=
LIFEOS_LON=
LIFEOS_WORK_ADDRESS=4411 W. Market St, Greensboro, NC 27405
# Optional: avoid geocoding by setting coordinates; or point at a live HA
# travel-time sensor such as sensor.home_to_work.
LIFEOS_WORK_LAT=
LIFEOS_WORK_LON=
LIFEOS_COMMUTE_ENTITY=
LIFEOS_CALENDAR_ENTITY=
# Free key from https://fdc.nal.usda.gov/api-key-signup.html. DEMO_KEY works at
# low rates for initial testing but should not be treated as production capacity.
USDA_FDC_API_KEY=DEMO_KEY

# Grocy pantry sync (create a key in Grocy → Settings → Manage API keys)
GROCY_URL=http://grocy
GROCY_API_KEY=

# Plex (profile: media) — claim token from https://plex.tv/claim (valid 4 min,
# only needed on first start). MEDIA_DIR holds your movies/tv/music folders.
PLEX_CLAIM=
MEDIA_DIR=

# LifeOS API protection (generate long random values)
LIFEOS_API_TOKEN=
LIFEOS_HEALTH_WEBHOOK_SECRET=

# Authenticated X1 Chromium retailer bridge (generate a different random value).
# Jarvis may scan offers and prepare a confirmed cart; checkout stays manual.
RETAILER_BRIDGE_URL=http://host.docker.internal:8766
RETAILER_BRIDGE_SECRET=

# Optional local meal-photo vision analysis (requires: docker compose --profile llm up -d)
LIFEOS_VISION_MODEL=gemma3:4b
LIFEOS_MAX_PHOTO_BYTES=8388608
# Privacy-minimized camera metadata is automatically deleted after this window.
LIFEOS_VISION_EVENT_RETENTION_HOURS=24

# Local visual-presence tuning. No images or video frames are sent to LifeOS.
GESTURE_PRESENCE_CLEAR_S=8
GESTURE_PRESENCE_HEARTBEAT_S=300

# UID of the Wayland kiosk user (run: id -u <user>)
KIOSK_UID=

# Continuous local conversation on the X1 (profile: conversation). The guarded
# bootstrap script detects these IDs automatically when they are not specified.
LVA_USER_ID=1000
LVA_USER_GROUP=1000
LVA_RUNTIME_DIR=/run/user/1000
LVA_PULSE_SERVER=/run/user/1000/pulse/native
LVA_CLIENT_NAME=Jarvis X1
LVA_WAKE_MODEL=hey_jarvis
LVA_STOP_MODEL=stop
LVA_CONTINUE_DELAY=0.55
LVA_AUDIO_INPUT_DEVICE=Jabra SPEAK 510 USB Mono
LVA_AUDIO_OUTPUT_DEVICE=pipewire
LVA_AUDIO_INPUT_CHANNELS=1
LVA_MIC_AUTO_GAIN=0
LVA_MIC_NOISE_SUPPRESSION=1
