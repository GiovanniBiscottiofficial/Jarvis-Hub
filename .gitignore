.env

# Home Assistant runtime files (created by HA at startup; only track our curated config)
ha-config/*
!ha-config/configuration.yaml
!ha-config/intents.yaml
!ha-config/custom_sentences
ha-config/custom_sentences/en/*
!ha-config/custom_sentences/en/*.yaml
!ha-config/automations
!ha-config/scripts
!ha-config/dashboards
ha-config/dashboards/*
!ha-config/dashboards/*.yaml
!ha-config/themes
ha-config/themes/*
!ha-config/themes/*.yaml
!ha-config/www
ha-config/www/*
!ha-config/www/jarvis-splash.html
!ha-config/www/jarvis-avatar.html
!ha-config/www/community
ha-config/automations/*
!ha-config/automations/*.yaml
ha-config/scripts/*
!ha-config/scripts/*.yaml

# Frigate runtime files (only track the starter config)
frigate/*
!frigate/config.yml

# HA secrets
ha-config/secrets.yaml
__pycache__/
